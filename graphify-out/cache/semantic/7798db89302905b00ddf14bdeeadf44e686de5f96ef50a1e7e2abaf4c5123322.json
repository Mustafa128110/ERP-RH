{"nodes": [{"id": "docs_phase_3_database_design", "label": "Phase 3 - Database Design", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_companies", "label": "companies table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_currencies", "label": "currencies table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_users", "label": "users table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flags users.password as a raw VARCHAR(50) too short for a bcrypt/argon2 hash, with no auth linkage, email, status, or soft-delete column - deferred to Phase 8 resolution (\u00a78.6)."}, {"id": "docs_phase_3_database_design_contacts", "label": "contacts table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unifies Customers and Suppliers via contact_type enum so a business that is both is one row, not two (\u00a70.2)."}, {"id": "docs_phase_3_database_design_categories", "label": "categories table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_brands", "label": "brands table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_units", "label": "units table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_unit_conversions", "label": "unit_conversions table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-item conversion factors matching FR-UNIT-003 - two products may share Box/Piece units but with different factors."}, {"id": "docs_phase_3_database_design_taxes", "label": "taxes table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_payment_methods", "label": "payment_methods table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_expense_categories", "label": "expense_categories table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_price_lists", "label": "price_lists table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Created but never referenced by any other table - no price_list_items, no FK from items or document_lines; flagged as a dead table (\u00a78.7)."}, {"id": "docs_phase_3_database_design_items", "label": "items table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "company_id required on items creates the same shared-master-data conflict as contacts (\u00a78.1); minimum_stock/reorder_level are single global values, not per-location (\u00a78.4)."}, {"id": "docs_phase_3_database_design_item_images", "label": "item_images table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_locations", "label": "locations table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces warehouses; adds damaged/reserved as first-class location types instead of a status flag on stock."}, {"id": "docs_phase_3_database_design_document_types", "label": "document_types table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seed rows drive per-document-type behavior so adding a new transaction type is a data insert, not a migration."}, {"id": "docs_phase_3_database_design_documents", "label": "documents table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per Purchase, Sale, Quotation, Transfer, Adjustment, Return, Invoice - document_type_id is what a Purchase *is*, not a separate table."}, {"id": "docs_phase_3_database_design_document_lines", "label": "document_lines table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_inventory_transactions", "label": "inventory_transactions table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Append-only stock ledger; stock-on-hand is SUM(movement*base_quantity) with no cached balance (\u00a70.3)."}, {"id": "docs_phase_3_database_design_chart_of_accounts", "label": "chart_of_accounts table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_ledger_entries", "label": "ledger_entries table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real double-entry accounting via CHECK enforcing exactly one side per row, replacing per-module ledger tables (\u00a70.4)."}, {"id": "docs_phase_3_database_design_attachments", "label": "attachments table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_3_database_design_audit_log", "label": "audit_log table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing ip_address/user_agent/reason columns, narrower than FR-AUDIT-001 (\u00a78.6)."}, {"id": "docs_phase_3_database_design_settings", "label": "settings table (Phase 3 description)", "file_type": "document", "source_file": "phase-3-database-design.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "company_id is required, so there is no slot for a truly global cross-company setting."}, {"id": "docs_phase_3_database_design_universal_document_pattern", "label": "Universal transaction pair pattern (documents + document_lines)", "file_type": "rationale", "source_file": "phase-3-database-design.md", "source_location": "section 0.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Config-driven design: every transaction type is a documents row typed by document_types instead of a bespoke table per business object, so adding a new transaction kind is a data insert, not a migration."}, {"id": "docs_phase_3_database_design_divergence_shared_master_data", "label": "Divergence 8.1: Contacts/Items not shared master data", "file_type": "rationale", "source_file": "phase-3-database-design.md", "source_location": "section 8.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "contacts.company_id and items.company_id are NOT NULL single FKs, contradicting the BRD's requirement that Products/Customers/Suppliers be shared across Royal Hardware and M52 with separate per-company balances - flagged as the single biggest conflict with the BRD, needing either nullable company_id + per-company balance join table, or a requirement change."}, {"id": "docs_phase_3_database_design_divergence_quotation_link", "label": "Divergence 8.2: No Quotation-to-Sale link", "file_type": "rationale", "source_file": "phase-3-database-design.md", "source_location": "section 8.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "documents has no source_document_id/parent_document_id column, so partial Quotation-to-Sale conversion (FR-QUO-002) has no representable state; needs a self-referencing FK or a document_relations table before Phase 9."}, {"id": "docs_phase_3_database_design_divergence_no_stock_cache", "label": "Divergence 8.3: No stock balance cache", "file_type": "rationale", "source_file": "phase-3-database-design.md", "source_location": "section 8.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every stock-on-hand read is a SUM() over full inventory_transactions history; functionally correct but flagged as a scaling risk versus the original draft's cached stock_balances table."}, {"id": "docs_phase_3_database_design_divergence_no_per_location_thresholds", "label": "Divergence 8.4: No per-location stock thresholds", "file_type": "rationale", "source_file": "phase-3-database-design.md", "source_location": "section 8.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "items.minimum_stock/reorder_level are single global values, but FR-PROD-008 requires thresholds per warehouse per product; needs an item_location_thresholds table."}, {"id": "docs_phase_3_database_design_divergence_no_sales_channels", "label": "Divergence 8.5: No Sales Channels table", "file_type": "rationale", "source_file": "phase-3-database-design.md", "source_location": "section 8.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No sales_channels table or column exists to record SHOP/WEB/M52/BALOCHISTAN or its mapping to a company for ledger/GST purposes, despite FR-SALE-001/002 requiring it."}, {"id": "docs_phase_3_database_design_divergence_narrow_users_audit", "label": "Divergence 8.6: Narrower Users/Audit than FR-USER/FR-AUDIT", "file_type": "rationale", "source_file": "phase-3-database-design.md", "source_location": "section 8.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "users has no auth linkage, roles/permissions tables, or hashing evidence for its VARCHAR(50) password column; audit_log lacks ip_address/user_agent/reason - both narrower than FR-USER-002/003 and FR-AUDIT-001 require."}, {"id": "docs_phase_3_database_design_divergence_no_whatsapp_backups_workflow", "label": "Divergence 8.7: No WhatsApp/Backups/Transfer workflow modeling", "file_type": "rationale", "source_file": "phase-3-database-design.md", "source_location": "section 8.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No whatsapp_templates/whatsapp_messages_log or backups tables exist; document_status has no transfer-specific states for FR-XFER-002's Initiated/In Transit/Received workflow; price_lists remains unwired."}], "edges": [{"source": "docs_db_royal_hardware_erp_sql_users", "target": "docs_phase_3_database_design_users", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-3-database-design.md", "source_location": "section 1", "weight": 1.0}, {"source": "docs_db_royal_hardware_erp_sql_currencies", "target": "docs_phase_3_database_design_currencies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-3-database-design.md", "source_location": "section 1", "weight": 1.0}, {"source": "docs_db_royal_hardware_erp_sql_companies", "target": "docs_phase_3_database_design_companies", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-3-database-design.md", "source_location": "section 1", "weight": 1.0}, {"sour