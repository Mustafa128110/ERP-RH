{"nodes": [{"id": "docs_phase_8_authentication", "label": "Phase 8 - Authentication & Authorization", "file_type": "document", "source_file": "phase-8-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_8_authentication_supabase_auth_identity_model", "label": "Supabase Auth identity model", "file_type": "rationale", "source_file": "phase-8-authentication.md", "source_location": "section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No self-signup since this is an internal tool - an Admin creates accounts via the Supabase Admin API createUser action, which also provisions the corresponding users row."}, {"id": "docs_phase_8_authentication_rbac_authorization_model", "label": "RBAC authorization model", "file_type": "rationale", "source_file": "phase-8-authentication.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "requirePermission checks role permissions plus user_company_access/user_warehouse_access scope, cached per-request so a permission change takes effect on the next request, not next login."}, {"id": "docs_phase_8_authentication_rls_defense_in_depth", "label": "RLS as defense-in-depth (app_user role + withUserContext)", "file_type": "rationale", "source_file": "phase-8-authentication.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drizzle's direct Postgres connection bypasses Supabase's auth.uid()/PostgREST machinery (BYPASSRLS), so a dedicated non-bypass app_user role is assumed via SET LOCAL ROLE inside withUserContext(userId, fn), and policies are written against current_setting('app.user_id') instead of auth.uid(). requirePermission gives good error messages; RLS makes it structurally impossible for a service bug to leak another company's row even if a permission check is skipped."}], "edges": [{"source": "docs_phase_7_api_design", "target": "docs_phase_8_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-8-authentication.md", "source_location": "header 'Depends on'", "weight": 1.0}, {"source": "docs_phase_3_database_design", "target": "docs_phase_8_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-8-authentication.md", "source_location": "header 'Depends on'", "weight": 1.0}, {"source": "docs_phase_8_authentication", "target": "docs_phase_11_testing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-8-authentication.md", "source_location": "Status line citing docs/phase-11-testing.md", "weight": 1.0}, {"source": "docs_phase_2_functional_requirements_fr_user_003", "target": "docs_phase_8_authentication_rbac_authorization_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-8-authentication.md", "source_location": "section 3", "weight": 1.0}, {"source": "docs_phase_5_folder_structure_company_warehouse_context", "target": "docs_phase_8_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-8-authentication.md", "source_location": "section 6", "weight": 1.0}, {"source": "docs_phase_7_api_design_require_permission", "target": "docs_phase_8_authentication_rbac_authorization_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-8-authentication.md", "source_location": "section 3", "weight": 1.0}, {"source": "docs_phase_7_api_design_require_permission", "target": "docs_phase_8_authentication_rls_defense_in_depth", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-8-authentication.md", "source_location": "section 4", "