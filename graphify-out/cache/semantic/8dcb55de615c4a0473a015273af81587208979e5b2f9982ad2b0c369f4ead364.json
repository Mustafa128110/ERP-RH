{"nodes": [{"id": "docs_phase_7_api_design", "label": "Phase 7 - API Design", "file_type": "document", "source_file": "phase-7-api-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_7_api_design_action_result_pattern", "label": "ActionResult discriminated union pattern", "file_type": "rationale", "source_file": "phase-7-api-design.md", "source_location": "section 0.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single result shape means every module's TanStack Query hook unwraps results identically and every form surfaces fieldErrors the same way, avoiding per-module bespoke error handling."}, {"id": "docs_phase_7_api_design_require_permission", "label": "requirePermission() guard", "file_type": "rationale", "source_file": "phase-7-api-design.md", "source_location": "section 0.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every Server Action follows the same five steps, with requirePermission throwing caught centrally and converted to PERMISSION_DENIED so individual actions never write their own auth-check logic."}, {"id": "docs_phase_7_api_design_atomic_idempotent_posting", "label": "Atomic idempotent posting pattern", "file_type": "rationale", "source_file": "phase-7-api-design.md", "source_location": "section 0.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every post action performs its status transition as a single conditional UPDATE...WHERE status='draft' inside the same transaction as stock/ledger writes; zero rows back means CONFLICT, making a double-click or client retry safe without a separate idempotency-key table."}, {"id": "docs_phase_7_api_design_route_handler_exceptions", "label": "Route Handlers as the exception, not the default", "file_type": "rationale", "source_file": "phase-7-api-design.md", "source_location": "section 0.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app/api/ exists only for callers that are not the ERP's own UI - the WhatsApp webhook, the backup cron, and binary PDF/CSV downloads."}], "edges": [{"source": "docs_phase_6_ui_wireframes", "target": "docs_phase_7_api_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-7-api-design.md", "source_location": "header 'Depends on'", "weight": 1.0}, {"source": "docs_phase_3_database_design", "target": "docs_phase_7_api_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-7-api-design.md", "source_location": "header 'Depends on'", "weight": 1.0}, {"source": "docs_phase_5_folder_structure", "target": "docs_phase_7_api_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-7-api-design.md", "source_location": "header 'Depends on'", "weight": 1.0}, {"source": "docs_phase_2_functional_requirements_fr_xfer_003", "target": "docs_phase_7_api_design_atomic_idempotent_posting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-7-api-design.md", "source_location": "section 1.3", "weight": 1.0}, {"source": "docs_phase_2_functional_requirements_fr_prod_002", "target": "docs_phase_7_api_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-7-api-design.md", "source_location": "section 1.2", "weight": 1.0}, {"source": "docs_phase_2_functional_requirements_fr_user_010", "target": "docs_phase_7_api_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-7-api-design.md", "source_location": "section 1.2", "weight": 1.0}, {"source": "docs_phase_2_functional_requirements_fr_sale_004", "target": "docs_phase_7_api_design", "relation": "references", "confidence": "EXTRACTED", "