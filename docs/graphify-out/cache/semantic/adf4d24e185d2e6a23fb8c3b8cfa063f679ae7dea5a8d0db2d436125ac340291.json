{"nodes": [{"id": "docs_phase_5_folder_structure", "label": "Phase 5 - Folder Structure", "file_type": "document", "source_file": "phase-5-folder-structure.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_phase_5_folder_structure_repository_pattern", "label": "Repository Pattern (strictly enforced)", "file_type": "rationale", "source_file": "phase-5-folder-structure.md", "source_location": "section 0.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only repositories/ imports @/lib/db; services never construct a Drizzle query directly - keeps business rules like FR-PROD-002 out of query code where they'd be easy to miss, and makes swapping the data layer later actually possible."}, {"id": "docs_phase_5_folder_structure_module_five_folder_pattern", "label": "Five-folder module pattern", "file_type": "rationale", "source_file": "phase-5-folder-structure.md", "source_location": "section 0.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every module (components/actions/services/repositories/schemas/types/hooks) has the same shape so any feature is navigated the same way as the module count grows."}, {"id": "docs_phase_5_folder_structure_audit_logging_service_layer", "label": "Audit logging as a service-layer concern", "file_type": "rationale", "source_file": "phase-5-folder-structure.md", "source_location": "section 0.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Postgres trigger can't see the requester's IP/user-agent, so every services/*.ts mutation calls a shared lib/audit/log.ts helper instead."}, {"id": "docs_phase_5_folder_structure_company_warehouse_context", "label": "CompanyProvider/WarehouseProvider context", "file_type": "rationale", "source_file": "phase-5-folder-structure.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side context is for UX only; Server Actions re-validate against user_company_access/user_warehouse_access server-side on every call, never trusting the client value as the access-control decision."}], "edges": [{"source": "docs_phase_3_database_design", "target": "docs_phase_5_folder_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-5-folder-structure.md", "source_location": "header 'Depends on'", "weight": 1.0}, {"source": "docs_phase_4_er_diagram", "target": "docs_phase_5_folder_structure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-5-folder-structure.md", "source_location": "header 'Depends on'", "weight": 1.0}, {"source": "docs_phase_2_functional_requirements_fr_prod_002", "target": "docs_phase_5_folder_structure_repository_pattern", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-5-folder-structure.md", "source_location": "section 0.2", "weight": 1.0}, {"source": "docs_phase_2_functional_requirements_fr_audit_001", "target": "docs_phase_5_folder_structure_audit_logging_service_layer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-5-folder-structure.md", "source_location": "section 0.3", "weight": 1.0}, {"source": "docs_phase_5_folder_structure_repository_pattern", "target": "docs_phase_5_folder_structure_module_five_folder_pattern", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "phase-5-folder-structure.md", "source_location": "section 0.2", "weight": 1.0}, {"source": "docs_phase_5_folder_structure_audit_logging_service_layer", "target": "docs_db_royal_hardware_erp_sql_audit_log", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "phase-5-folder-structure.md", "s