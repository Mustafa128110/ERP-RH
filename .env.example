[TEMPLATE]
# Copy to .env for local development, and set every variable in Vercel
# (Production + Preview) for deployment. Values shown are placeholders.
#
# These are the only variables the app reads. Everything the codebase used to
# take (WhatsApp keys, Google Drive, CRON_SECRET, GEMINI_API_KEY) has been
# removed, so a template listing them would be a promise nothing keeps.

# --- Supabase (database + auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>            # server only, never expose
DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Optional shared cache (Upstash free tier) ---
# Leave both blank to use direct database reads.  A quota/network failure opens
# a short circuit and does the same; financial writes never depend on caching.
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# --- Settings → Backups manual workflow controls ---
# Fine-grained GitHub token, server only. Repository metadata: read; Actions:
# read/write.  Do not add this token to GitHub Actions secrets: the web app
# needs it in its own runtime environment to start a workflow from Settings.
GITHUB_BACKUP_DISPATCH_TOKEN=<github-fine-grained-token>
# Optional when the app is deployed from a fork. Defaults to Mustafa128110/ERP-RH.
GITHUB_BACKUP_REPOSITORY=Mustafa128110/ERP-RH
